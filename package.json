        "dev:tfgf:mp-weixin": "cross-env NODE_ENV=development VUE_APP_THEME_TYPE=tfgf UNI_PLATFORM=mp-weixin UNI_OUTPUT_DIR=dist/dev/tfjh vue-cli-service uni-build --watch --minimize --mode development.tfgf",
        "prod:tfgf:mp-weixin": "cross-env NODE_ENV=production VUE_APP_THEME_TYPE=tfgf UNI_PLATFORM=mp-weixin UNI_OUTPUT_DIR=dist/build/tfjh vue-cli-service uni-build --watch --minimize --mode production.tfgf",
        "dev:zgx:mp-weixin": "cross-env NODE_ENV=development VUE_APP_THEME_TYPE=zgx UNI_PLATFORM=mp-weixin UNI_OUTPUT_DIR=dist/dev/zgx vue-cli-service uni-build --watch --minimize --mode development.zgx",
        "prod:zgx:mp-weixin": "cross-env NODE_ENV=production VUE_APP_THEME_TYPE=zgx UNI_PLATFORM=mp-weixin UNI_OUTPUT_DIR=dist/build/zgx vue-cli-service uni-build --watch --minimize --mode production.zgx",
        "dev:kjg:mp-weixin": "cross-env NODE_ENV=development VUE_APP_THEME_TYPE=kjg UNI_PLATFORM=mp-weixin UNI_OUTPUT_DIR=dist/dev/kjg vue-cli-service uni-build --watch --minimize --mode development.kjg",
        "dev:integration:kjg:mp-weixin": "cross-env NODE_ENV=development VUE_APP_THEME_TYPE=kjg UNI_PLATFORM=mp-weixin UNI_OUTPUT_DIR=dist/dev/kjg-integration vue-cli-service uni-build --watch --minimize --mode integration.kjg",
        "build:kjg:mp-weixin": "cross-env NODE_ENV=production VUE_APP_THEME_TYPE=kjg UNI_PLATFORM=mp-weixin UNI_OUTPUT_DIR=dist/build/kjg vue-cli-service uni-build --minimize --mode production.kjg",
        "postbuild:kjg:mp-weixin": "node scripts/prepare-mp-project-config.js dist/build/kjg .env.production.kjg",
        "prod:kjg:mp-weixin": "cross-env NODE_ENV=production VUE_APP_THEME_TYPE=kjg UNI_PLATFORM=mp-weixin UNI_OUTPUT_DIR=dist/build/kjg vue-cli-service uni-build --watch --minimize --mode production.kjg"
